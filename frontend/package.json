{
  "name": "reviva-velas",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "node set-env.js && ng build",
    "watch": "ng build --watch --configuration development",
   "set-env": "node -e \"const fs = require('fs'); const file = 'src/environments/environment.prod.ts'; let content = fs.readFileSync(file, 'utf8'); content = content.replace('MERCADO_PAGO_ACCESS_TOKEN_PLACEHOLDER', process.env.MERCADO_ACCESS_TOKEN || ''); fs.writeFileSync(file, content);\""
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^17.3.0",
    "@angular/common": "^17.3.0",
    "@angular/compiler": "^17.3.0",
    "@angular/core": "^17.3.0",
    "@angular/forms": "^17.3.0",
    "@angular/platform-browser": "^17.3.0",
    "@angular/platform-browser-dynamic": "^17.3.0",
    "@angular/router": "^17.3.0",
    "@emailjs/browser": "^4.4.1",
    "@mercadopago/sdk-js": "^0.0.3",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.14.4"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^17.3.0",
    "@angular/cli": "^17.3.0",
    "@angular/compiler-cli": "^17.3.0",
    "typescript": "~5.4.2"
  }
}
